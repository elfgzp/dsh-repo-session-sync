{
  "name": "dsh-repo-session-sync",
  "version": "0.0.1",
  "description": "Sync DeepSeek Harness sessions with git repositories across machines: code travels by git, conversation state travels with it. 把 DSH 会话与 git 仓库绑定，在多机之间同步会话状态——代码走 git，对话跟着走。",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session-sync",
    "git",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elfgzp/dsh-repo-session-sync.git"
  },
  "homepage": "https://github.com/elfgzp/dsh-repo-session-sync",
  "bugs": {
    "url": "https://github.com/elfgzp/dsh-repo-session-sync/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0",
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check client.js",
    "smoke": "bash scripts/smoke-load.sh",
    "test:unit": "node --test \"test/**/*.test.js\""
  }
}
